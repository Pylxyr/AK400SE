<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AK400SE</AssemblyName>
    <RootNamespace>AK400SE</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>src/app.ico</ApplicationIcon>
    <!-- `dotnet publish -c Release` produces a self-contained win-x64 folder (the .NET runtime is included; nothing to install first).
         WinForms cannot be trimmed (the SDK disables it), so the framework is shipped whole and the installer compresses it. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Single source of truth for the version. scripts/version.ps1 and the "Cut release" workflow rewrite this line. -->
    <Version>0.2.0</Version>
    <Product>AK400SE</Product>
    <Description>Tray app for the DeepCool AK400 DIGITAL SE display</Description>
    <Copyright>Copyright (c) 2026 Pylxyr</Copyright>
    <!-- footprint: no globalization tables, no background/server GC threads, no PGO instrumentation -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>false</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**" />
    <EmbeddedResource Include="src/app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="src/Ui/fonts/DSEG7Classic-Bold.ttf" LogicalName="digits.ttf" />
    <!-- the font is under the SIL Open Font License, which requires its license text to travel with it -->
    <None Include="ThirdParty/DSEG-LICENSE.txt" Link="ThirdParty/DSEG-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>
</Project>
