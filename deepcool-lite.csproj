<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>deepcool-lite</AssemblyName>
    <RootNamespace>DeepCoolLite</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- `dotnet publish -c Release` alone produces the release exe: framework-dependent, single file, win-x64 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Single source of truth for the version. scripts/version.ps1 and the "Cut release" workflow rewrite this line. -->
    <Version>0.1.0</Version>
    <Product>deepcool-lite</Product>
    <Description>Minimal driver for the DeepCool AK400 DIGITAL SE display</Description>
    <Copyright>Copyright (c) 2026 Pylxyr</Copyright>
    <!-- footprint: no globalization tables, no background/server GC threads, no PGO instrumentation -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>false</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>
</Project>
